{
  "name": "sprout-lands-adventure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8190 --strictPort --host 0.0.0.0",
    "build": "npm run check:art && npm run check:world && vite build",
    "preview": "vite preview --port 8190 --strictPort --host 0.0.0.0",
    "test": "node test/run-tests.mjs",
    "sync-art": "node scripts/sync-art.mjs",
    "check:art": "node scripts/sync-art.mjs --check",
    "check:ui": "node scripts/tools/ui-check.mjs",
    "check:quest": "node scripts/tools/quest-check.mjs",
    "check:blocked": "node scripts/tools/blocked-check.mjs",
    "check:treats": "node scripts/tools/treats-check.mjs",
    "check:rooms": "node scripts/tools/room-check.mjs",
    "check:bakery": "node scripts/tools/bakery-check.mjs",
    "check:world": "node scripts/check-world.mjs",
    "check:offline": "node scripts/tools/offline-check.mjs",
    "check:offline-phone": "node scripts/tools/offline-phone-check.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.1"
  }
}
