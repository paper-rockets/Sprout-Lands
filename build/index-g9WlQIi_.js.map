        "right": 5,
        "front": 6,
        "topLeft": 7,
        "topRight": 8,
        "bottomLeft": 9,
        "bottomRight": 10,
        "frontLeftOfDoor": 12,
        "frontRightOfDoor": 13
      },
      "wood-plank": {
        "tex": "tiles-rooms",
        "floor": 1,
        "door": 14,
        "backTop": 2,
        "backBottom": 3,
        "left": 4,
        "right": 5,
        "front": 6,
        "topLeft": 7,
        "topRight": 8,
        "bottomLeft": 9,
        "bottomRight": 10,
        "frontLeftOfDoor": 12,
        "frontRightOfDoor": 13
      },
      "cave-stone": {
        "shape": "cave",
        "tex": "tiles-cave-walls",
        "floorTex": "tiles-cave-floor",
        "floor": [[7, 6], [6, 7], [7, 7], [8, 6], [6, 5], [7, 5]],
        "floorRare": [[8, 5], [9, 5], [10, 5], [9, 6], [10, 6], [6, 6], [8, 7], [9, 7], [10, 7], [6, 8], [7, 8], [8, 8], [9, 8]],
        "rareEvery": 6,
