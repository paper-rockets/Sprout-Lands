    {"id": "forest-pudding", "name": "Pudding", "character": "pudding-pup", "alt": {"character": "sky-puppy", "name": "Sky"}, "dialogue": "forest-pudding", "facing": "down", "at": [13, 16], "favourite": {"treat": "food-pudding", "say": "PUDDING! MY VERY OWN NAME! IT'S WOBBLY AND PERFECT. THANK YOU, {name}!", "hint": "DO YOU KNOW WHY I'M CALLED PUDDING? BECAUSE IT'S MY FAVOURITE TREAT IN THE WHOLE WORLD!", "gift": {"coins": 5}, "giftSay": "I'VE BEEN SAVING THESE COINS. YOU SHOULD HAVE THEM!"}},
